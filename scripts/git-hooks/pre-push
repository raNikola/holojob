#!/bin/sh
# Tracked pre-push hook, enabled by scripts/install-git-hooks.sh (core.hooksPath).
# Bypass, skipping the remote guard as well: git push --no-verify
#
# $1 is the remote name, $2 its URL; each stdin line is one ref being pushed:
# <local ref> <local sha> <remote ref> <remote sha>
set -u

# Personal job-search data must never leave the owner's accounts: the only allowed
# target is origin at the owner's private repo. The URL is pinned too, because a remote
# can be renamed or repointed (a fresh clone of upstream calls upstream "origin").
# It comes first: it also covers deletions and tag pushes, which skip the checks below.
case "${1:-}:${2:-}" in
  origin:git@github.com:raNikola/holojob.git) ;;
  *)
    echo "Refusing push to ${1:-} (${2:-}): only origin (git@github.com:raNikola/holojob.git) is allowed." >&2
    exit 1 ;;
esac

# The commits that would land on a branch. Deleted branches (an all-zero local sha)
# and tags are not checked.
shas=
remote_shas=
while read -r _local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  case " $shas " in *" $local_sha "*) ;; *) shas="$shas $local_sha"; remote_shas="$remote_shas $local_sha:$remote_sha" ;; esac
done
[ -n "$shas" ] || exit 0

die() {
  echo "pre-push: $1" >&2
  echo "pre-push: push stopped. To push anyway (also skips the remote guard): git push --no-verify" >&2
  exit 1
}

top=$(git rev-parse --show-toplevel 2>/dev/null) || die "cannot find the repository root"
# Git may export these to the hook; the checks must not inherit them.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

# Commits have the owner as the only author. Only commits the remote does not have yet are read:
# history that is already pushed is not rewritten and must not block a push.
for sha in $shas; do
  new_commits=$(git -C "$top" rev-list "$sha" --not --remotes="$1") || die "cannot list the commits of $sha"
  for commit in $new_commits; do
    if git -C "$top" log -1 --format=%B "$commit" | grep -qiE 'co-authored-by:|claude-session:|generated with claude code'; then
      die "commit ${commit%"${commit#???????}"} has an attribution line (Co-Authored-By:, Claude-Session: or Generated with Claude Code); commits have the owner as the only author"
    fi
  done
done

command -v podman >/dev/null 2>&1 || die "podman not found"
[ -d "$top/node_modules" ] || die "node_modules missing (see Tests in CLAUDE.md)"
[ -x "$top/.venv/bin/python" ] || die ".venv/bin/python missing (see Tests in CLAUDE.md)"

# Two tiers (scripts/test-tier.sh). Fast, the default: lint, the tests related to what the push changes, the meta tests.
# Full, on demand: HOLOJOB_PUSH_TIER=full git push ..., or run it first: sh scripts/test-tier.sh full
tier=${HOLOJOB_PUSH_TIER:-fast}
case "$tier" in fast | full) ;; *) die "HOLOJOB_PUSH_TIER must be fast or full, not $tier" ;; esac

total_started=$(date +%s)
for sha in $shas; do
  # What the remote already has: the sha it reports for this branch if we know it, else where the commit left origin/main.
  base=
  for r in $remote_shas; do
    case "$r" in "$sha":*) base=${r#*:}; break ;; esac
  done
  case "$base" in *[!0]*) git -C "$top" cat-file -e "$base^{commit}" 2>/dev/null || base= ;; *) base= ;; esac
  sh "$top/scripts/test-tier.sh" "$tier" "$sha" "$base" || die "$tier tier failed for ${sha%"${sha#???????}"}"
done
echo "pre-push: $tier tier passed in $(($(date +%s) - total_started))s"
