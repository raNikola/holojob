# Career OS local server
PORT=5173

# Origins allowed to call /api (comma separated). Behind a reverse proxy list its public name plus the local one;
# with an empty list only the request's own Host is accepted as Origin. See CLAUDE.md, Request guard.
# The port is published on 127.0.0.1 only (docker-compose.yml); a LAN IP no longer reaches the app.
# CAREER_OS_ALLOWED_ORIGINS=https://careeros.void,http://localhost:3073

# Set to 0 to disable auto-opening Terminal for Claude Code login on startup
CLAUDE_AUTO_LOGIN=1

# Optional: LinkedIn li_at cookie for deep outreach contact discovery
# LINKEDIN_LI_AT=

# Phase 1 engine in shadow mode: 1 shows its Fit next to matchScore, read only.
# Matcher calls happen only in a judged run (confirm dialog); default off.
# CAREER_OS_ENGINE_SHADOW=1

# Optional cloud AI providers. Set the key in Settings > Privacy (data/secrets/, read by Node and Python).
# These are a fallback used only when the store has none for the selected provider; the intended setup leaves them unset.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
